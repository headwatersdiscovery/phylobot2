// PhyloBot pipeline configuration. Environment differences belong in profiles,
// never in process code.

params {
    input         = null      // unaligned protein FASTA (optional if --alignment is given)
    // 'protein', or 'codon' for coding DNA (translated for the amino-acid steps; codon
    // alignments published beside them), with an NCBI genetic code number (1 = standard;
    // the codes IQ-TREE or PAML offer: src/phylobot/codons.py).
    seqtype       = 'protein'
    genetic_code  = 1
    alignment     = null      // provided alignment(s): comma-separated paths or a list
    alignment_labels = null   // optional display labels, same order (list in a params file)
    alignment_keys = null     // per alignment, an inherited aligner key or 'provided' (main.nf)
    skip_combinations = null  // an extension: the extended job's combinations, not rerun
    modelfinder_reused = null // an extension: aligners whose ModelFinder pick is reused...
    modelfinder_picks = null  // ...from this folder (<aligner>.model.txt, .modelfinder.tsv)
    tree          = null      // provided tree(s): comma-separated paths or a list
    tree_labels   = null
    tree_branch_lengths = null // per provided tree: fit (default) or keep (-blfix)
    outdir        = 'results'
    aligners      = 'mafft'   // comma-separated, or 'none'; first is the primary combination
                              // (mafft, muscle, clustalo, prank; prank_codon for coding DNA)
    tree_builders = 'iqtree'  // comma-separated, or 'none'
    // Models (see src/phylobot/catalog.py). modelfinder: one combination choosing among
    // `candidates` (null: `models`, or IQ-TREE's default set if that is null too; the
    // whole catalog also means the default set). fixed_models: each of `models` gets its
    // own full tree search (a combination). Both may be on.
    modelfinder   = true
    fixed_models  = false
    models        = null      // catalog models: comma-separated or a list
    candidates    = null      // catalog models: comma-separated or a list
    // Codon models (coding DNA only; catalog codon models): each gets its own combination
    // on the codon alignment, like a fixed model (IQ-TREE tree search, fits to provided
    // trees; no RAxML-NG). ModelFinder chooses among amino-acid models only.
    codon_models  = null
    // Codon ModelFinder (coding DNA): one 'modelfinder_codon' combination per alignment and
    // tree source, choosing among codon_candidates (null or every catalog codon model:
    // IQ-TREE's own default codon set).
    codon_modelfinder = false
    codon_candidates  = null
    // Codon combinations' trees from IQ-TREE and RAxML-NG: 'search' (a tree search under
    // each codon model; IQ-TREE only) and/or 'amino' (each codon model fitted on an
    // amino-acid tree: no codon search, much cheaper). codon_amino_trees: 'best' (each
    // alignment's amino-acid tree of lowest BIC, per tree source) or 'all' (every one).
    // Provided trees are fitted under each codon model either way.
    codon_trees       = 'search'
    codon_amino_trees = 'best'
    // PAML codeml (coding DNA, with codon models): site models among M0, M1a, M2a, M3,
    // M7, M8 (comma-separated or a list; src/phylobot/codeml.py), run on each alignment's
    // best codon combination by BIC ('best') or on every codon combination ('all').
    codeml_models = null
    codeml_trees  = 'best'
    // The branch-site test alone (codeml Model A vs its null): one codon --alignment and
    // one --tree with codeml's #1 / $1 marks on the foreground branches (see main.nf).
    branch_site   = false
    // A simulation alone (see main.nf): a JSON spec (src/phylobot/simulate/spec.py), plus
    // the tree and root sequence files when the spec does not draw them at random.
    simulate      = null
    sim_tree      = null
    sim_root      = null

    // Gap placement in ancestors: comma-separated parsimony, fitch, ml, prank, grasp, or
    // 'none'. Copies are written as ancestors.gaps-<method>.fasta; ancestors.fasta stays.
    // Unset: fitch with an outgroup, parsimony (shared presence) without one, as on the
    // New Job page (owner decision; gaps.default_methods).
    gap_methods   = null
    // Tier-0 property posteriors per ancestral node. Comma-separated
    // keys from phylobot.properties.REGISTRY, or '' for none. **On by default** (owner,
    // 2026-10-20), so a hand-run pipeline measures what a web job measures; the New Job
    // page still passes its keys explicitly. The cost is real and known: on Ime2 this
    // step took 39 s of a 78 s job, because it measures every ancestral node in every
    // gap version at property_draws draws. Set `--properties ''` to turn it off.
    properties    = 'charge,moment,hydropathy_regions'
    property_draws = 1000
    // Measuring properties on ancestors a finished job already published: no
    // reconstruction, only PROPERTIES over staged combinations.
    // properties_dir holds <aligner>/<tree>/<model>/ directories of published files and
    // property_targets is a TSV (combination, node) of exactly what to measure.
    properties_only = false
    properties_dir = null
    property_targets = null
    // Where a finished job's ancestral uncertainty comes from: no
    // reconstruction, one UNCERTAINTY over the job's staged results (uncertainty_dir:
    // summary.json and its <aligner>/<tree>/<model>/ folders) with the run's settings
    // (uncertainty_settings, a JSON file).
    uncertainty_only = false
    uncertainty_dir = null
    uncertainty_settings = null
    // Extant-sequence reconstruction: no tree search, one alignment, tree and
    // model staged in esr_dir (alignment.fasta, tree.nwk, model.txt, settings.json).
    esr = false
    esr_dir = null
    // The last stage to run: 'alignments', 'trees' (no ancestral reconstruction) or
    // 'ancestors' (the whole pipeline).
    stop_after    = 'ancestors'
    // Outgroup sequence names (comma-separated or a list): roots each tree; required by
    // the prank and grasp gap methods.
    outgroup      = null
    // Gene-tree / species-tree reconciliation: species_map is a
    // species table (species.tsv: columns sequence and species; `phylobot-species
    // resolve` writes one) and species_tree a Newick tree of those species (polytomies
    // allowed). Given both, every combination's tree is reconciled with the species tree
    // (GeneRax, UndatedDL): duplications, losses and its root, in reconciliation.tsv/.json.
    // polytomies: how the species tree's polytomies are resolved, 'guided' by the job's
    // gene trees or 'arbitrary' (from the seed).
    species_map   = null
    species_tree  = null
    polytomies    = 'guided'

    // Branch support: replicates, 0 disables; otherwise 1000-10000 (IQ-TREE's minimum is
    // 1000). UFBoot only on IQ-TREE's own trees (IQ-TREE refuses it on a fixed topology);
    // SH-aLRT on every tree. Both on: IQ-TREE labels nodes 'SH-aLRT/UFBoot'.
    bootstrap     = 1000     // UFBoot
    alrt          = 0        // SH-aLRT
    seed          = 1

    // Guardrails on user input (owner decision).
    max_sequences = 500
    max_length    = 5000
    max_provided  = 5         // provided alignments, and provided trees, each

    // Every tool container, pinned.
    containers {
        // Our own steps: built locally from docker/tools.Dockerfile by `make pipeline`.
        // Moves to a registry with versioned tags in the AWS phase.
        tools  = 'phylobot-tools:local'
        // phylobot-tools plus torch, metapredict and ESM-2 weights (docker/ml.Dockerfile;
        // make ml-image). Only PROPERTIES uses it, and only for the neural predictors.
        ml     = 'phylobot-ml:local'
        mafft  = 'quay.io/biocontainers/mafft:7.525--h031d066_1'
        muscle = 'quay.io/biocontainers/muscle:5.3--h9948957_3'
        clustalo = 'quay.io/biocontainers/clustalo:1.2.4--h503566f_10'
        prank  = 'quay.io/biocontainers/prank:251117--hd63eeec_0'  // binary reports v.250331
        // GRASP 2.0.0, built locally (make grasp-image; bnkit has no licence to redistribute)
        grasp  = 'phylobot-grasp:2.0.0'
        iqtree = 'quay.io/biocontainers/iqtree:3.1.3--h8471819_0'
        raxml  = 'quay.io/biocontainers/raxml-ng:2.0.3--h870a6a7_0'
        paml   = 'quay.io/biocontainers/paml:4.10.10--h87e0c26_2'
        // GeneRax 2.1.3, bioconda build hf316886_2 (2024-12-13), by digest: the newer
        // hf316886_3 segfaults. AGPL-3.0:
        // run as published, never patched or mirrored without a source offer.
        generax = 'quay.io/biocontainers/generax@sha256:a2052f3b3126b013c5a8bb5b3c77ed69e3e13e372e3a262b5b764fff4c80d382'
    }
}

process {
    cpus   = 1      // single-threaded by default: reproducible results
    // A reservation (Nextflow runs only as many tasks as fit in its memory) and a hard
    // limit (docker --memory). A task killed for exceeding it (exit 137) runs once more
    // with twice as much; the worker's resources.config caps that at the job's share.
    // 2 GB is the default for runs without the worker; web jobs reserve the Settings
    // page's "Memory each pipeline step reserves" instead (resources.config replaces
    // this; phylobot.machine.DEFAULT_TASK_MEMORY mirrors the 2 GB; a test pins them).
    memory        = { 2.GB * task.attempt }
    errorStrategy = { task.exitStatus == 137 && task.attempt == 1 ? 'retry' : 'terminate' }
    maxRetries    = 1
    // Owner decision, 2026-10-21: raised from 2h. It is the only runaway protection
    // there is (no job-level timeout), so it stays finite. 2h was sized on Ime2 and
    // killed real work: PRANK on lrrk2 (83 seqs to 3034 aa) died mid-refinement at
    // 2h00m01s, and gba1's tree searches (131 seqs) project 2h20-3h10 each. Both are
    // amd64 containers emulated on Apple Silicon, roughly 3x a native core.
    time   = '8h'
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.tsv"
    // Written as tasks finish; the worker reads it for progress and per-task logs.
    fields    = 'task_id,hash,name,status,exit,submit,start,complete,realtime,cpus,%cpu,peak_rss,duration,workdir'
}

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}

profiles {
    docker {
        docker.enabled    = true
        // BioContainers publish amd64 only; on Apple Silicon these run emulated.
        // The nextflow/nextflow image bundles Docker CLI 19.03, which refuses an explicit
        // --platform unless the daemon has experimental features on; it does take the
        // platform from DOCKER_DEFAULT_PLATFORM, so the worker and runner set that.
        // PHYLOBOT_DOCKER_CPUSET (.env; `make docker-cpus` suggests a value) keeps every
        // task container on those CPUs. OrbStack isolates its VM's last CPU (isolcpus):
        // emulated IQ-TREE lands there and is never moved off, so concurrent IQ-TREE tasks
        // share that one core. Unset, containers may use every CPU. Only digits, commas
        // and hyphens are accepted: the value reaches each task's shell command line.
        docker.runOptions = [
            System.getenv('DOCKER_DEFAULT_PLATFORM') ? '' : '--platform linux/amd64',
            !System.getenv('PHYLOBOT_DOCKER_CPUSET') ? ''
                : System.getenv('PHYLOBOT_DOCKER_CPUSET') ==~ /\d+(-\d+)?(,\d+(-\d+)?)*/
                ? "--cpuset-cpus=${System.getenv('PHYLOBOT_DOCKER_CPUSET')}"
                : { throw new IllegalArgumentException("PHYLOBOT_DOCKER_CPUSET must look like 0-6 or 0,2-5, not '${System.getenv('PHYLOBOT_DOCKER_CPUSET')}'") }(),
        ].findAll().join(' ')
    }
}
