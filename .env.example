# `make env` (run by `make up`) copies this to .env and generates its credentials.
# Never commit .env.

# --- Deployment mode: local (no accounts; this machine only) or cloud (accounts) ---
PHYLOBOT_MODE=local

# --- Django ---
# Credentials left empty here are generated for this install by `make env` (and so by
# `make up`): scripts/env-secrets.sh. No two installs share one.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Postgres ---
# Containers connect to db:5432. From this machine (Postico, psql etc.): 127.0.0.1:5433.
POSTGRES_DB=phylobot
POSTGRES_USER=phylobot
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Object storage (Garage locally, S3 in production) ---
S3_ENDPOINT_URL=http://garage:3900
S3_BUCKET=phylobot
# The local Garage server's access key, generated for this install when S3_ENDPOINT_URL
# is the local Garage (scripts/garage-init.sh, run by `make up`, imports it into Garage).
# The names are AWS_* because boto3 reads these variables. On AWS, leave both UNSET:
# boto3 then uses the machine's IAM role, so no keys are stored anywhere.
# NEVER put real AWS keys in this file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Must match s3_region in docker/garage/garage.toml.
AWS_DEFAULT_REGION=us-east-1

# --- Garage node (local dev only) ---
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# --- Homolog search ---
# EBI and NCBI require a contact email with every search (they write if a search causes
# trouble). Yours when PhyloBot runs on your machine; the operator's on a hosted site.
# Searches are refused while this is empty.
PHYLOBOT_SEARCH_EMAIL=

# --- Pipeline runner ---
# PROJECT_ROOT (the repo's absolute path, mounted at the same path in the runner)
# is set automatically by the Makefile; set it here only to run compose directly.

# --- Pipeline CPUs (check this on every new machine: make docker-cpus) ---
# The CPUs of Docker's Linux VM that pipeline steps may use, as Docker's --cpuset-cpus
# takes them ("0-6", "0,2-5"); empty means all of them. Run `make docker-cpus`: it reads
# the VM and prints the value for this machine. `make up` and `make pipeline` warn when
# the value leaves an isolated CPU in use, and stop when it names CPUs the VM lacks.
#   OrbStack (Apple Silicon): its VM isolates its last CPU (isolcpus), and emulated
#     IQ-TREE ends up stuck there, so all IQ-TREE steps share one core (5x slower with
#     five running). With 8 CPUs in OrbStack's settings: 0-6; with 10: 0-8.
#   Docker Desktop, Linux, cloud: usually nothing is isolated; leave it empty.
# Recheck after changing the CPU count in your Docker runtime's settings: a CPU the VM no
# longer has makes every step fail to start. Restart the worker after changing it (make
# up, when no job runs).
PHYLOBOT_DOCKER_CPUSET=

# --- The machine's CPUs and memory for pipeline steps (phylobot.machine) ---
# Empty means what the worker detects from Docker (on a Mac, Docker's VM), checked again
# whenever a job starts. Set them to give pipelines less, or if detection is wrong. The
# Settings page overrides all three, and shows what is in force under "This machine".
# Each job that can run at once gets an equal share of what remains after the reserve.
PHYLOBOT_CPUS=
PHYLOBOT_MEMORY_GB=
# Memory never given to pipeline steps: the web portal, Postgres, Garage, the desktop.
# Empty means 2 (GB).
PHYLOBOT_RESERVED_MEMORY_GB=
# Memory each pipeline step reserves; a job runs as many steps at once as its share
# holds. Steps use far less on typical families (tens of MB), so 1 lets more run at
# once. A step that runs out is retried once with twice as much. Empty means 2 (GB).
PHYLOBOT_TASK_MEMORY_GB=

# --- Jobs ---
# 1 = archive failed jobs' work folders to object storage, so they can be resumed after
# the worker's disk is lost (a replaced cloud machine). Also a switch on the Settings page.
PHYLOBOT_ARCHIVE_FAILED_WORK=
